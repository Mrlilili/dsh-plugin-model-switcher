{
  "name": "dsh-plugin-model-switcher",
  "version": "0.1.0",
  "description": "DSH plugin: keyboard shortcuts to switch models and reasoning effort levels",
  "license": "MIT",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    }
  },
  "files": [
    "src/",
    "cordis.patch.yml"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "keywords": ["dsh", "dsh-plugin", "model-switcher", "keyboard-shortcuts"],
  "repository": {
    "type": "git",
    "url": "https://github.com/Mrlilili/dsh-plugin-model-switcher"
  }
}